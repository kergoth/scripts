#!/usr/bin/env python3
"""Recreate a dead GoodLinks link at a new URL, carrying metadata over.

GoodLinks has no way to edit a saved link's URL, so a dead link (moved,
gone, replaced by an archive.org/archive.ph copy) has to be re-added at
the new location. This copies summary/tags/starred/read/addedAt from the old entry to a new
one, cross-links both entries via a [migrated-from]/[migrated-to] marker
in their summaries, and tags the old entry: status/highlights-orphaned
(plus status/highlights-elsewhere on the new entry) if it has highlights
the API can't move, otherwise to-remove since there's nothing left to
preserve there.

Deliberately does NOT carry the title over: a dead link is sometimes dead
because the source renamed the post/slug, in which case the old title no
longer matches the new page. Left unset, GoodLinks fetches the new page's
own title at save time, same as a normal save. Pass --title to force one.

Caveat: `links add` upserts on URL match, including trashed entries. If
new_url was already saved before (e.g. a prior run you deleted and are
retrying), the omitted title won't be freshly fetched -- it stays whatever
that existing/trashed record already had. Pass --title explicitly to be
sure in that situation.

Never deletes the old entry. Dry-run by default; pass --apply to write.

    goodlinks-migrate-link OLD_ID 'https://example.com/new-location'
    goodlinks-migrate-link OLD_ID 'https://example.com/new-location' --apply
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from typing import Any

STATUS_ORPHANED_DEFAULT = "status/highlights-orphaned"
STATUS_ELSEWHERE_DEFAULT = "status/highlights-elsewhere"
REMOVE_TAG_DEFAULT = "to-remove"
SUMMARY_MAX = 400


def run_ctl(args: list[str], json_mode: bool) -> dict[str, Any]:
    proc = subprocess.run(
        ["goodlinksctl", "--json", *args], text=True, capture_output=True, check=False
    )
    if proc.returncode != 0:
        if json_mode:
            sys.stderr.write(proc.stderr or proc.stdout)
        else:
            sys.stderr.write(proc.stderr or proc.stdout)
        raise SystemExit(proc.returncode)
    return json.loads(proc.stdout)


def highlight_count(link_id: str, json_mode: bool) -> int:
    payload = run_ctl(
        ["highlights", "list", "--link-id", link_id, "--all-pages"], json_mode
    )
    return len(payload.get("data", []))


def with_breadcrumb(summary: str | None, marker: str) -> str:
    base = (summary or "").strip()
    text = f"{base} {marker}".strip() if base else marker
    if len(text) > SUMMARY_MAX:
        overflow = len(text) - SUMMARY_MAX
        base = base[: max(0, len(base) - overflow)].rstrip()
        text = f"{base} {marker}".strip() if base else marker
    return text[:SUMMARY_MAX]


def build_plan(args: argparse.Namespace, old: dict[str, Any], highlights: int) -> dict[str, Any]:
    own_tags = {args.status_tag_orphaned, args.status_tag_elsewhere, args.remove_tag}
    old_tags = (
        []
        if args.no_carry_tags
        else [t for t in (old.get("tags") or []) if t not in own_tags]
    )
    new_tags = old_tags + list(args.tag)

    if highlights > 0:
        old_tag = args.status_tag_orphaned
        new_tags.append(args.status_tag_elsewhere)
    elif not args.no_remove_tag:
        old_tag = args.remove_tag
    else:
        old_tag = None

    new_summary = with_breadcrumb(
        args.summary if args.summary is not None else old.get("summary"),
        f"[migrated-from: {args.old_id}]",
    )
    old_summary = with_breadcrumb(old.get("summary"), "[migrated-to: <pending>]")

    return {
        "mode": "apply" if args.apply else "dry-run",
        "old_id": args.old_id,
        "new_id": None,
        "new_url": args.new_url,
        "highlight_count": highlights,
        "old_tag_added": old_tag,
        "new_tags": sorted(set(new_tags)),
        "new_title": args.title,
        "new_summary": new_summary,
        "old_summary": old_summary,
        "added_at": old.get("addedAt"),
        "starred": bool(old.get("starred")),
        "read": bool(old.get("readAt")),
    }


def apply_plan(plan: dict[str, Any], json_mode: bool) -> None:
    add_args = [
        "links",
        "add",
        plan["new_url"],
        "--summary",
        plan["new_summary"],
        "--added-at",
        plan["added_at"] or "",
    ]
    if plan["new_title"]:
        add_args += ["--title", plan["new_title"]]
    for tag in plan["new_tags"]:
        add_args += ["--tag", tag]
    add_args.append("--read" if plan["read"] else "--unread")
    add_args.append("--starred" if plan["starred"] else "--unstarred")

    new_link = run_ctl(add_args, json_mode)
    plan["new_id"] = new_link["id"]
    if not plan["new_title"]:
        plan["new_title"] = new_link.get("title")

    old_summary = plan["old_summary"].replace("<pending>", plan["new_id"])
    plan["old_summary"] = old_summary
    update_args = ["links", "update", plan["old_id"], "--summary", old_summary]
    if plan["old_tag_added"]:
        update_args += ["--add-tag", plan["old_tag_added"]]
    run_ctl(update_args, json_mode)


def print_report(plan: dict[str, Any], json_mode: bool, quiet: bool) -> None:
    if json_mode:
        print(json.dumps(plan))
        return

    new_id = plan["new_id"] or "<pending>"
    if not quiet:
        print(
            f"add\t{plan['new_url']}\ttitle={plan['new_title'] or '(auto-fetched)'}\t"
            f"tags={','.join(plan['new_tags']) or '-'}\t"
            f"starred={str(plan['starred']).lower()}\tread={str(plan['read']).lower()}"
        )
        if plan["old_tag_added"]:
            print(f"update\t{plan['old_id']}\t+tag={plan['old_tag_added']}\tsummary+=[migrated-to: {new_id}]")
        else:
            print(f"update\t{plan['old_id']}\tsummary+=[migrated-to: {new_id}]")
    print(
        f"summary\tmode={plan['mode']}\told_id={plan['old_id']}\tnew_id={new_id}\t"
        f"highlights={plan['highlight_count']}"
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("old_id", help="GoodLinks ID of the dead-link entry to replace")
    parser.add_argument("new_url", help="Replacement URL (archive copy, new location, etc.)")
    parser.add_argument("--apply", action="store_true", help="Write changes instead of dry-run")
    parser.add_argument(
        "--title", help="Force a title instead of letting GoodLinks fetch it from the new URL"
    )
    parser.add_argument("--summary", help="Override summary instead of carrying it from the old entry")
    parser.add_argument(
        "--tag", action="append", default=[], help="Extra tag for the new entry; repeat as needed"
    )
    parser.add_argument(
        "--no-carry-tags", action="store_true", help="Don't copy the old entry's tags to the new one"
    )
    parser.add_argument(
        "--status-tag-orphaned",
        default=STATUS_ORPHANED_DEFAULT,
        help=f"Tag applied to the old entry when it has highlights (default: {STATUS_ORPHANED_DEFAULT})",
    )
    parser.add_argument(
        "--status-tag-elsewhere",
        default=STATUS_ELSEWHERE_DEFAULT,
        help=f"Tag applied to the new entry when the old one has highlights (default: {STATUS_ELSEWHERE_DEFAULT})",
    )
    parser.add_argument(
        "--remove-tag",
        default=REMOVE_TAG_DEFAULT,
        help=f"Tag applied to the old entry when it has no highlights (default: {REMOVE_TAG_DEFAULT})",
    )
    parser.add_argument(
        "--no-remove-tag",
        action="store_true",
        help="Don't tag the old entry when it has no highlights",
    )
    parser.add_argument("--json", action="store_true", help="Emit a single JSON object")
    parser.add_argument("-q", "--quiet", action="store_true", help="Only print the summary line")
    args = parser.parse_args()

    if not (args.new_url.startswith("http://") or args.new_url.startswith("https://")):
        sys.stderr.write(f"error: new_url must be http(s): {args.new_url!r}\n")
        return 2

    old = run_ctl(["links", "get", args.old_id], args.json)
    highlights = highlight_count(args.old_id, args.json)
    plan = build_plan(args, old, highlights)

    if args.apply:
        apply_plan(plan, args.json)

    print_report(plan, args.json, args.quiet)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
