#!/usr/bin/env python3
"""Remove GoodLinks links whose URL scheme GoodLinks can't render.

GoodLinks renders http:/https: URLs in-app. Any other scheme (mailto:,
tel:, sms:, facetime:, itms-apps:, market:, ...) hands off to another app
instead of showing content, so these are junk saves rather than readable
links.

Dry-run by default; pass --apply to actually delete via the GoodLinks CLI.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from typing import Any
from urllib.parse import urlsplit

READABLE_SCHEMES = {"http", "https"}
GOODLINKS_CLI_DIR = os.environ.get(
    "GOODLINKS_CLI_DIR", "/Applications/GoodLinks.app/Contents/MacOS/CLI"
)

# The GoodLinks app ships its CLI inside the app bundle, off PATH; set
# GOODLINKS_CLI_DIR to point at a stub or a relocated copy.
os.environ["PATH"] = f"{GOODLINKS_CLI_DIR}:{os.environ.get('PATH', '')}"


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True)


def fetch_links() -> list[dict[str, Any]]:
    cmd = ["goodlinks-links-json"]
    proc = run(cmd)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout)
        raise SystemExit(proc.returncode)
    payload = json.loads(proc.stdout)
    return payload.get("data", [])


def scheme_of(link: dict[str, Any]) -> str:
    return urlsplit(str(link.get("url", ""))).scheme.lower()


def has_unreadable_scheme(link: dict[str, Any]) -> bool:
    return scheme_of(link) not in READABLE_SCHEMES


def delete(ids: list[str]) -> int:
    missing = [
        link_id
        for link_id in ids
        if subprocess.run(
            ["goodlinks", "link", "id", link_id],
            text=True,
            capture_output=True,
            check=False,
        ).returncode != 0
    ]
    if missing:
        sys.stderr.write(f"preflight failed, missing {','.join(missing)}\n")
        print("preflight reported failures, aborting delete", file=sys.stderr)
        return 1

    proc = subprocess.run(
        ["goodlinks", "link", "delete", *ids],
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout)
        return proc.returncode
    print(proc.stdout)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--apply", action="store_true", help="Delete instead of dry-run"
    )
    args = parser.parse_args()

    links = fetch_links()
    pending = [link for link in links if has_unreadable_scheme(link)]
    for link in pending:
        print(f"{link['id']}\t{scheme_of(link)}\t{link.get('url', '')}\t{link.get('title', '')}")

    mode = "apply" if args.apply else "dry-run"
    print(f"summary\tmode={mode}\tmatched={len(pending)}")

    if not pending:
        return 0
    if not args.apply:
        return 0
    return delete([link["id"] for link in pending])


if __name__ == "__main__":
    raise SystemExit(main())
