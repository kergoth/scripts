#!/usr/bin/env python3
"""Tag/untag Readwise Reader documents returned by reader-search-documents."""

from __future__ import annotations

import argparse
import json
import shlex
import subprocess
import sys
from typing import Any


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True)


def split_tags(value: str | None) -> list[str]:
    if not value:
        return []
    return [t.strip() for t in value.split(",") if t.strip()]


def extract_docs(payload: Any) -> tuple[list[dict[str, Any]], str | None]:
    if isinstance(payload, list):
        return [d for d in payload if isinstance(d, dict)], None

    if not isinstance(payload, dict):
        return [], None

    candidates = [
        payload.get("documents"),
        payload.get("results"),
        payload.get("items"),
        payload.get("data"),
    ]
    docs: list[dict[str, Any]] = []
    for c in candidates:
        if isinstance(c, list):
            docs = [d for d in c if isinstance(d, dict)]
            break

    next_cursor = (
        payload.get("next_page_cursor")
        or payload.get("nextPageCursor")
        or payload.get("cursor")
        or payload.get("next_cursor")
    )
    if next_cursor is not None:
        next_cursor = str(next_cursor)
    return docs, next_cursor


def doc_id(doc: dict[str, Any]) -> str | None:
    for key in ("document_id", "id"):
        v = doc.get(key)
        if v:
            return str(v)
    return None


def supports_page_cursor() -> bool:
    help_cmd = ["readwise", "reader-search-documents", "--help"]
    proc = run(help_cmd)
    if proc.returncode != 0:
        return False
    text = proc.stdout + proc.stderr
    return "--page-cursor" in text


def search_all(search_args: list[str], page_size: int) -> list[dict[str, Any]]:
    can_page = supports_page_cursor()
    seen: set[str] = set()
    docs: list[dict[str, Any]] = []

    cursor: str | None = None
    first = True
    while True:
        cmd = ["readwise", "reader-search-documents", *search_args, "--limit", str(page_size), "--json"]
        if cursor and can_page:
            cmd.extend(["--page-cursor", cursor])

        proc = run(cmd)
        if proc.returncode != 0:
            sys.stderr.write(proc.stderr or proc.stdout)
            raise SystemExit(proc.returncode)

        try:
            payload = json.loads(proc.stdout)
        except json.JSONDecodeError as e:
            sys.stderr.write(f"Failed to parse JSON from: {' '.join(shlex.quote(x) for x in cmd)}\n")
            sys.stderr.write(str(e) + "\n")
            raise SystemExit(2)

        page_docs, next_cursor = extract_docs(payload)
        new_count = 0
        for d in page_docs:
            did = doc_id(d)
            if not did or did in seen:
                continue
            seen.add(did)
            docs.append(d)
            new_count += 1

        if not can_page:
            break
        if not next_cursor:
            break
        if new_count == 0 and not first:
            break

        cursor = next_cursor
        first = False

    return docs


def tags_for_doc(doc: dict[str, Any]) -> set[str]:
    tags = doc.get("tags")
    if not isinstance(tags, list):
        return set()
    return {str(t) for t in tags}


def fetch_source_url(document_id: str) -> str:
    cmd = [
        "readwise",
        "reader-list-documents",
        "--id",
        document_id,
        "--response-fields",
        "source_url,url",
        "--json",
    ]
    proc = run(cmd)
    if proc.returncode != 0:
        return ""
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return ""

    results = payload.get("results") if isinstance(payload, dict) else None
    if not isinstance(results, list) or not results:
        return ""
    first = results[0]
    if not isinstance(first, dict):
        return ""
    return str(first.get("source_url") or first.get("url") or "")


def mutate_tags(document_id: str, add: list[str], remove: list[str], dry_run: bool) -> tuple[bool, list[str]]:
    changes: list[str] = []
    ok = True

    if add:
        changes.append(f"+{','.join(add)}")
        if not dry_run:
            cmd = [
                "readwise",
                "reader-add-tags-to-document",
                "--document-id",
                document_id,
                "--tag-names",
                ",".join(add),
            ]
            proc = run(cmd)
            if proc.returncode != 0:
                ok = False
                sys.stderr.write(proc.stderr or proc.stdout)

    if remove:
        changes.append(f"-{','.join(remove)}")
        if not dry_run:
            cmd = [
                "readwise",
                "reader-remove-tags-from-document",
                "--document-id",
                document_id,
                "--tag-names",
                ",".join(remove),
            ]
            proc = run(cmd)
            if proc.returncode != 0:
                ok = False
                sys.stderr.write(proc.stderr or proc.stdout)

    return ok, changes


def _domain_from_url(value: str) -> str:
    try:
        from urllib.parse import urlparse

        host = (urlparse(value).hostname or "").lower()
        if host.startswith("www."):
            host = host[4:]
        return host
    except Exception:
        return ""


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Search Reader docs then set/unset tags on matches.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Example:\n"
            "  readwise-tag-search --add-tags do,video -- --query youtube.com --location-in new,later\n"
            "  readwise-tag-search --remove-tags inbox -- --query 'rust' --tags-search inbox\n"
        ),
    )
    parser.add_argument("--add-tags", help="Comma-separated tags to add")
    parser.add_argument("--remove-tags", help="Comma-separated tags to remove")
    parser.add_argument("--page-size", type=int, default=100, help="Search page size (default: 100)")
    parser.add_argument("--dry-run", action="store_true", help="Show actions, do not mutate")
    parser.add_argument("--strict-url-contains", action="append", default=[], help="Post-filter: document URL must contain this substring (repeatable)")
    parser.add_argument("--strict-domain", action="append", default=[], help="Post-filter: document URL hostname must equal this domain (repeatable)")
    parser.add_argument("search_args", nargs=argparse.REMAINDER, help="Arguments passed directly to reader-search-documents (prefix with --)")

    args = parser.parse_args()
    add_tags = split_tags(args.add_tags)
    remove_tags = split_tags(args.remove_tags)

    if not add_tags and not remove_tags:
        parser.error("Need --add-tags and/or --remove-tags")

    search_args = args.search_args
    if search_args and search_args[0] == "--":
        search_args = search_args[1:]

    if "--json" in search_args:
        search_args = [x for x in search_args if x != "--json"]

    if "--limit" in search_args:
        i = search_args.index("--limit")
        if i + 1 < len(search_args):
            del search_args[i : i + 2]

    if "--query" not in search_args:
        parser.error("search_args must include --query ...")

    docs = search_all(search_args, args.page_size)
    matched = 0
    changed = 0
    failed = 0

    strict_domains = {x.lower().removeprefix('www.') for x in args.strict_domain if x.strip()}
    strict_contains = [x for x in args.strict_url_contains if x]
    need_strict = bool(strict_domains or strict_contains)

    for d in docs:
        did = doc_id(d)
        if not did:
            continue

        doc_url = str(d.get("source_url") or d.get("url") or "")
        author = str(d.get("author") or "")
        if need_strict and (not doc_url or "read.readwise.io/read/" in doc_url):
            fetched_url = fetch_source_url(did)
            if fetched_url:
                doc_url = fetched_url

        strict_haystacks = [doc_url, author]
        if strict_contains and not all(any(s in h for h in strict_haystacks) for s in strict_contains):
            continue
        if strict_domains:
            hosts = {_domain_from_url(doc_url), _domain_from_url(author)}
            hosts.discard("")
            if hosts.isdisjoint(strict_domains):
                continue

        matched += 1

        existing = tags_for_doc(d)
        add = [t for t in add_tags if t not in existing]
        remove = [t for t in remove_tags if t in existing]
        if not add and not remove:
            continue

        ok, changes = mutate_tags(did, add, remove, args.dry_run)
        title = str(d.get("title", ""))
        print(f"{did}\t{' '.join(changes)}\t{title}")

        if ok:
            changed += 1
        else:
            failed += 1

    mode = "dry-run" if args.dry_run else "apply"
    print(f"summary\tmode={mode}\tmatched={matched}\tchanged={changed}\tfailed={failed}")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
