#!/usr/bin/env python3
"""Find GoodLinks links saved more than once.

GoodLinks does not reliably dedupe on exact URL match at save time --
two entries with byte-identical URLs are possible; how they end up that
way isn't known. Default mode groups links by their raw saved URL, no
network calls required.

Pass --follow-redirects to additionally catch duplicates that only match
once redirects are followed (shortlinks, AMP, tracking params the origin
strips) -- this resolves every saved URL over HTTP and groups by the
*resolved* URL instead, which is slower and network-dependent.

Pass --canonical to go a step further and group by each page's declared
<link rel="canonical"> URL instead (implies --follow-redirects, since it
needs the fetched page). Falls back to the resolved URL for pages with no
canonical tag or an unparseable one -- canonical tags are opt-in and
sometimes wrong, so treat this as a third, noisier tier on top of
--follow-redirects rather than a replacement for it.

Pass --trailing-slash to group non-root saved URLs that differ only by their
terminal slash. The command resolves only those candidate records and reports
whether an origin redirected one saved URL to another record's exact saved
URL. This is evidence for manual review, not a duplicate decision.

Read-only: reports groups only, does not delete or tag anything. Review each
group and remove the ones you don't want to keep, e.g.:

    goodlinks-find-dupes --json \\
        | jq -r '.entries[1:][].id' \\
        | xargs goodlinksctl links delete --dry-run
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import urllib.error
import urllib.request
from collections import defaultdict
from concurrent.futures import ThreadPoolExecutor, as_completed
from html.parser import HTMLParser
from typing import Any
from urllib.parse import urljoin, urlsplit

DEFAULT_WORKERS = 8
DEFAULT_TIMEOUT = 15.0
USER_AGENT = "goodlinks-find-dupes/1.0"
MAX_CANONICAL_BODY_BYTES = 2 * 1024 * 1024


class CanonicalLinkParser(HTMLParser):
    """Extract the first <link rel="canonical" href="..."> found."""

    def __init__(self) -> None:
        super().__init__()
        self.canonical: str | None = None

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if self.canonical is not None or tag != "link":
            return
        values = dict(attrs)
        rel = (values.get("rel") or "").lower().split()
        href = values.get("href")
        if "canonical" in rel and href:
            self.canonical = href


def extract_canonical(html: str) -> str | None:
    parser = CanonicalLinkParser()
    try:
        parser.feed(html)
    except Exception:  # noqa: BLE001 - malformed HTML must not abort the run
        pass
    return parser.canonical


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True)


def fetch_links(verbosity: int) -> list[dict[str, Any]]:
    if verbosity >= 0:
        print("fetching links from goodlinks...", file=sys.stderr, flush=True)
    cmd = ["goodlinksctl", "--json", "links", "list", "--all-pages", "--limit", "250"]
    proc = run(cmd)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout)
        raise SystemExit(proc.returncode)
    payload = json.loads(proc.stdout)
    links = payload.get("data", [])
    if verbosity >= 0:
        print(f"fetched {len(links)} links", file=sys.stderr, flush=True)
    return links


def build_entry(link: dict[str, Any]) -> dict[str, Any]:
    return {
        "id": link.get("id", ""),
        "url": link.get("url", ""),
        "title": link.get("title", ""),
        "tags": link.get("tags") or [],
        "starred": link.get("starred", False),
        "highlighted": link.get("highlighted", False),
        "read_at": link.get("readAt"),
        "word_count": link.get("wordCount"),
        "added_at": link.get("addedAt"),
    }


def resolve_entry(
    entry: dict[str, Any], timeout: float, want_canonical: bool
) -> dict[str, Any]:
    url = entry["url"]
    entry["resolved_url"] = url
    if want_canonical:
        entry["canonical_url"] = url

    if not url or url.lower().startswith("mailto:"):
        return entry

    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            entry["resolved_url"] = resp.geturl()
            if want_canonical:
                entry["canonical_url"] = entry["resolved_url"]
                body = resp.read(MAX_CANONICAL_BODY_BYTES)
                charset = resp.headers.get_content_charset() or "utf-8"
                html = body.decode(charset, errors="replace")
                href = extract_canonical(html)
                if href:
                    entry["canonical_url"] = urljoin(entry["resolved_url"], href)
    except (urllib.error.URLError, TimeoutError, OSError):
        # Unresolvable links (dead, timed out) can't be grouped by redirect
        # target; check-links already covers those separately.
        pass
    except Exception:  # noqa: BLE001 - one bad link must not abort the run
        pass

    return entry


def resolve_entries(
    entries: list[dict[str, Any]],
    workers: int,
    timeout: float,
    verbosity: int,
    want_canonical: bool,
) -> list[dict[str, Any]]:
    if verbosity >= 0:
        label = "canonical urls" if want_canonical else "redirects"
        print(f"resolving {label}...", file=sys.stderr, flush=True)
    resolved: list[dict[str, Any]] = []
    with ThreadPoolExecutor(max_workers=workers) as pool:
        futures = [
            pool.submit(resolve_entry, entry, timeout, want_canonical)
            for entry in entries
        ]
        for future in as_completed(futures):
            entry = future.result()
            resolved.append(entry)
            if verbosity > 0:
                target = entry["canonical_url"] if want_canonical else entry["resolved_url"]
                changed = target != entry["url"]
                suffix = f" -> {target}" if changed else ""
                print(f"{entry['url']}{suffix}", file=sys.stderr, flush=True)
            elif verbosity == 0:
                print(".", end="", file=sys.stderr, flush=True)
    if verbosity == 0:
        print(file=sys.stderr)
    return resolved


def resolve_trailing_slash_entry(entry: dict[str, Any], timeout: float) -> dict[str, Any]:
    url = entry["url"]
    result: dict[str, Any] = {
        "ok": None,
        "status": None,
        "final_url": url,
        "error": None,
    }
    entry["redirect"] = result

    if not url or url.lower().startswith("mailto:"):
        result["error"] = "skipped: not http(s)"
        return entry

    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            result.update(
                ok=resp.status is not None and 200 <= resp.status < 400,
                status=resp.status,
                final_url=resp.geturl(),
            )
    except urllib.error.HTTPError as exc:
        result.update(
            ok=False,
            status=exc.code,
            final_url=exc.geturl(),
            error=f"http {exc.code}",
        )
    except urllib.error.URLError as exc:
        result.update(ok=False, error=str(exc.reason))
    except TimeoutError:
        result.update(ok=False, error="timeout")
    except OSError as exc:
        result.update(ok=False, error=str(exc))
    except Exception as exc:  # noqa: BLE001 - one bad link must not abort the run
        result.update(ok=False, error=f"unexpected: {exc}")

    return entry


def resolve_trailing_slash_groups(
    groups: list[list[dict[str, Any]]],
    workers: int,
    timeout: float,
    verbosity: int,
) -> None:
    entries = [entry for group in groups for entry in group]
    if verbosity >= 0:
        print(f"resolving redirects for {len(entries)} trailing-slash candidates...", file=sys.stderr, flush=True)
    with ThreadPoolExecutor(max_workers=workers) as pool:
        futures = [
            pool.submit(resolve_trailing_slash_entry, entry, timeout) for entry in entries
        ]
        for future in as_completed(futures):
            entry = future.result()
            redirect = entry["redirect"]
            if verbosity > 0:
                suffix = ""
                if redirect["final_url"] != entry["url"]:
                    suffix = f" -> {redirect['final_url']}"
                print(f"{entry['url']}{suffix}", file=sys.stderr, flush=True)
            elif verbosity == 0:
                print(".", end="", file=sys.stderr, flush=True)
    if verbosity == 0:
        print(file=sys.stderr)


def fetch_trailing_slash_highlight_info(link_id: str) -> dict[str, Any]:
    cmd = [
        "goodlinksctl",
        "--json",
        "highlights",
        "list",
        "--link-id",
        link_id,
        "--all-pages",
    ]
    proc = run(cmd)
    if proc.returncode != 0:
        return {"count": None, "error": f"goodlinksctl exited {proc.returncode}"}
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {"count": None, "error": "invalid GoodLinksCTL JSON"}
    return {"count": len(payload.get("data", [])), "error": None}


def annotate_trailing_slash_highlights(
    groups: list[list[dict[str, Any]]], workers: int, verbosity: int
) -> None:
    entries = [entry for group in groups for entry in group if entry["id"]]
    if not entries:
        return
    if verbosity >= 0:
        print(f"checking highlights for {len(entries)} trailing-slash candidates...", file=sys.stderr, flush=True)
    with ThreadPoolExecutor(max_workers=workers) as pool:
        infos = list(pool.map(fetch_trailing_slash_highlight_info, [entry["id"] for entry in entries]))
    for entry, info in zip(entries, infos, strict=True):
        entry["highlights"] = info


def fetch_highlight_count(link_id: str) -> int:
    cmd = [
        "goodlinksctl",
        "--json",
        "highlights",
        "list",
        "--link-id",
        link_id,
        "--all-pages",
    ]
    proc = run(cmd)
    if proc.returncode != 0:
        return 0
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return 0
    return len(payload.get("data", []))


def annotate_highlight_counts(
    groups: list[list[dict[str, Any]]], workers: int, verbosity: int
) -> None:
    ids = [entry["id"] for group in groups for entry in group if entry["id"]]
    if not ids:
        return
    if verbosity >= 0:
        print(f"checking highlights for {len(ids)} duplicate links...", file=sys.stderr, flush=True)
    with ThreadPoolExecutor(max_workers=workers) as pool:
        counts = dict(zip(ids, pool.map(fetch_highlight_count, ids)))
    for group in groups:
        for entry in group:
            entry["highlight_count"] = counts.get(entry["id"], 0)


def group_by_key(
    entries: list[dict[str, Any]], key: str
) -> list[list[dict[str, Any]]]:
    groups: dict[str, list[dict[str, Any]]] = defaultdict(list)
    for entry in entries:
        groups[entry[key]].append(entry)
    return [grp for grp in groups.values() if len(grp) > 1]


def normalize_trailing_slash_url(url: str) -> str:
    path = urlsplit(url).path
    if path in ("", "/") or not path.endswith("/"):
        return url

    suffix_start = len(url)
    for delimiter in ("?", "#"):
        index = url.find(delimiter)
        if index >= 0:
            suffix_start = min(suffix_start, index)
    return url[: suffix_start - 1] + url[suffix_start:]


def build_trailing_slash_groups(
    entries: list[dict[str, Any]],
) -> list[list[dict[str, Any]]]:
    groups: dict[str, list[dict[str, Any]]] = defaultdict(list)
    for entry in entries:
        entry["normalized_url"] = normalize_trailing_slash_url(entry["url"])
        groups[entry["normalized_url"]].append(entry)

    result = [
        group
        for group in groups.values()
        if len({entry["url"] for entry in group}) > 1
    ]
    return sorted(result, key=lambda group: group[0]["normalized_url"])


def find_redirect_relations(entries: list[dict[str, Any]]) -> list[dict[str, str]]:
    entries_by_url: dict[str, list[dict[str, Any]]] = defaultdict(list)
    for entry in entries:
        entries_by_url[entry["url"]].append(entry)

    relations: list[dict[str, str]] = []
    for entry in entries:
        redirect = entry.get("redirect", {})
        final_url = redirect.get("final_url")
        if (
            redirect.get("ok") is not True
            or final_url == entry["url"]
            or final_url not in entries_by_url
        ):
            continue
        for destination in entries_by_url[final_url]:
            relations.append(
                {
                    "from_id": entry["id"],
                    "from_url": entry["url"],
                    "to_id": destination["id"],
                    "to_url": destination["url"],
                    "final_url": final_url,
                }
            )
    return sorted(relations, key=lambda relation: (relation["from_id"], relation["to_id"]))


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "-r",
        "--follow-redirects",
        action="store_true",
        help="also resolve redirects over HTTP and group by the resolved URL (slower, network-dependent)",
    )
    parser.add_argument(
        "-c",
        "--canonical",
        action="store_true",
        help="group by each page's <link rel=canonical> URL instead (implies "
        "--follow-redirects; falls back to the resolved URL when no "
        "canonical tag is found)",
    )
    parser.add_argument(
        "--trailing-slash",
        action="store_true",
        help="group terminal-slash variants and report redirect evidence; incompatible with --follow-redirects and --canonical",
    )
    parser.add_argument(
        "-j",
        "--workers",
        type=int,
        default=DEFAULT_WORKERS,
        help=f"parallel checks with --follow-redirects or --trailing-slash (default: {DEFAULT_WORKERS})",
    )
    parser.add_argument(
        "-t",
        "--timeout",
        type=float,
        default=DEFAULT_TIMEOUT,
        help=f"per-request timeout with --follow-redirects or --trailing-slash (default: {DEFAULT_TIMEOUT})",
    )
    parser.add_argument(
        "--json", action="store_true", help="emit one JSON object per group"
    )
    parser.add_argument(
        "-v",
        dest="verbosity",
        action="count",
        default=0,
        help="print each url as it's checked instead of a progress dot",
    )
    parser.add_argument(
        "-q",
        dest="quiet",
        action="count",
        default=0,
        help="suppress progress output (summary still printed)",
    )
    args = parser.parse_args()
    if args.trailing_slash and (args.follow_redirects or args.canonical):
        parser.error("--trailing-slash cannot be combined with --follow-redirects or --canonical")
    verbosity = args.verbosity - args.quiet

    links = fetch_links(verbosity)
    entries = [build_entry(link) for link in links]

    follow_redirects = args.follow_redirects or args.canonical
    if args.trailing_slash:
        groups = build_trailing_slash_groups(entries)
        resolve_trailing_slash_groups(groups, args.workers, args.timeout, verbosity)
        annotate_trailing_slash_highlights(groups, args.workers, verbosity)
        group_key = "normalized_url"
    elif follow_redirects:
        entries = resolve_entries(
            entries, args.workers, args.timeout, verbosity, args.canonical
        )
        group_key = "canonical_url" if args.canonical else "resolved_url"
        groups = group_by_key(entries, group_key)
        groups.sort(key=lambda grp: grp[0][group_key])
        annotate_highlight_counts(groups, args.workers, verbosity)
    else:
        group_key = "url"
        groups = group_by_key(entries, group_key)
        groups.sort(key=lambda grp: grp[0][group_key])
        annotate_highlight_counts(groups, args.workers, verbosity)

    for group in groups:
        if args.json:
            payload: dict[str, Any] = {"url": group[0][group_key], "entries": group}
            if args.trailing_slash:
                payload["redirects"] = find_redirect_relations(group)
            print(json.dumps(payload))
        else:
            for entry in group:
                if args.trailing_slash:
                    redirect = entry["redirect"]
                    highlights = entry.get("highlights", {"count": None, "error": "not checked"})
                    meta = (
                        f"tags={','.join(entry['tags']) or '-'}"
                        f" starred={entry['starred']}"
                        f" highlighted={entry['highlighted']}"
                        f" highlights={highlights['count'] if highlights['count'] is not None else '?'}"
                        f" highlight_error={highlights['error'] or '-'}"
                        f" read={'yes' if entry['read_at'] else 'no'}"
                        f" words={entry['word_count'] if entry['word_count'] is not None else '-'}"
                        f" added={entry['added_at'] or '-'}"
                    )
                    columns = [
                        entry["id"],
                        entry["url"],
                        entry["normalized_url"],
                        redirect["final_url"],
                        redirect["error"] or "-",
                        entry["title"],
                        meta,
                    ]
                else:
                    meta = (
                        f"tags={','.join(entry['tags']) or '-'}"
                        f" starred={entry['starred']}"
                        f" highlights={entry.get('highlight_count', 0)}"
                        f" read={'yes' if entry['read_at'] else 'no'}"
                        f" words={entry['word_count'] if entry['word_count'] is not None else '-'}"
                        f" added={entry['added_at'] or '-'}"
                    )
                    columns = [entry["id"], entry["url"]]
                    if follow_redirects and entry["resolved_url"] != entry["url"]:
                        columns.append(entry["resolved_url"])
                    if (
                        args.canonical
                        and entry["canonical_url"] not in (entry["url"], entry["resolved_url"])
                    ):
                        columns.append(entry["canonical_url"])
                    columns += [entry["title"], meta]
                print("\t".join(columns))
            if args.trailing_slash:
                for relation in find_redirect_relations(group):
                    print(
                        "\t".join(
                            [
                                "redirect",
                                relation["from_id"],
                                relation["from_url"],
                                relation["to_id"],
                                relation["to_url"],
                                relation["final_url"],
                            ]
                        )
                    )
            print()

    checked = sum(len(group) for group in groups) if args.trailing_slash else len(entries)
    print(
        f"summary\tchecked={checked}\tgroups={len(groups)}",
        file=sys.stderr,
    )

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
