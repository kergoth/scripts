#!/usr/bin/env bash
# Usage: llm-server [-B backend] [-s state_dir] [options] command [model] [args]
#
# Manage one active local OpenAI-compatible model server for agents and chat.
#
# Commands:
#     list                    List configured physical model profiles
#     start <model>           Start one model server
#     switch <model>          Stop the active managed server and start another
#     stop <model|all>        Stop one model server or all
#     restart <model>         Restart one model server
#     status [model|all]      Show status for one model or all (default: all)
#     is-running <model>      Exit 0 when model is running, 1 when not running
#     logs <model> [lines]    Show log output for model (default: 40 lines)
#     follow-logs <model>     Follow logs for model
#     doctor [--deep]         Check runtime state; --deep also tests chat/tool requests
#
# Options:
#     -B BACKEND              Backend override: vllm-mlx or swiftlm
#     -s DIR                  State directory (default: $LLM_SERVER_STATE_DIR or $XDG_STATE_HOME/llm-server)
#     -n                      Dry run, don't actually do anything
#     -v                      Increase verbosity, can be specified multiple times
#     -q                      Decrease verbosity, can be specified multiple times
#     -h                      Show this help message
set -euo pipefail

dry_run=0
verbosity=0
backend_override=
state_dir=${LLM_SERVER_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/llm-server}

model_backend=
model_id=
model_port=
model_vllm_mlx_args=()
model_swiftlm_args=()

command_name=
command_model=
command_arg=
doctor_deep=0
cmd=()

model_names=("agent" "assistant" "quality")

usage() {
    sed -n '/^# Usage:/,/^# *-h /p' "${BASH_SOURCE[0]}" | sed 's/^# *//'
}

process_arguments() {
    while getopts ":B:s:nvqh" opt; do
        case "$opt" in
            B)
                backend_override=$OPTARG
                ;;
            s)
                state_dir=$OPTARG
                ;;
            n)
                dry_run=1
                ;;
            v)
                verbosity=$((verbosity + 1))
                ;;
            q)
                verbosity=$((verbosity - 1))
                ;;
            h)
                usage
                exit 0
                ;;
            \?)
                msg_red "Unknown option: -$OPTARG"
                usage >&2
                exit 1
                ;;
            :)
                msg_red "Option -$OPTARG requires an argument"
                usage >&2
                exit 1
                ;;
        esac
    done
    shift $((OPTIND - 1))

    command_name=${1:-status}
    command_model=${2:-all}
    command_arg=${3:-}

    if [ "$command_name" = "doctor" ] && [ "${command_model:-}" = "--deep" ]; then
        doctor_deep=1
        command_model=all
    fi
}

msg() {
    local fmt=$1
    shift || true
    # shellcheck disable=SC2059
    printf -- "$fmt\n" "$@" >&2
}

msg_color() {
    local color=$1
    shift
    local fmt=$1
    shift || true
    # shellcheck disable=SC2059
    if [ -n "${NO_COLOR:-}" ] || { [ -z "${COLOR:-}" ] && ! [ -t 2 ]; }; then
        printf -- "$fmt\n" "$@" >&2
    else
        printf -- "\033[%sm$fmt\033[0m\n" "$color" "$@" >&2
    fi
}

msg_green() {
    msg_color "32" "$@"
}

msg_red() {
    msg_color "31" "$@"
}

msg_yellow() {
    msg_color "33" "$@"
}

msg_verbose() {
    if [ "$verbosity" -gt 0 ]; then
        msg_yellow "$@"
    fi
}

print_shell_command() {
    local arg
    local rendered=

    for arg in "$@"; do
        if [ -n "$rendered" ]; then
            rendered+=" "
        fi
        printf -v rendered '%s%q' "$rendered" "$arg"
    done

    printf '%s\n' "$rendered"
}

die() {
    msg_red "$@"
    exit 1
}

run() {
    if [ "$verbosity" -gt 0 ] || [ "$dry_run" -eq 1 ]; then
        msg "+ %s" "$(print_shell_command "$@")"
    fi
    if [ "$dry_run" -eq 1 ]; then
        return 0
    fi
    "$@"
}

ensure_state_dir() {
    run mkdir -p "$state_dir"
}

is_known_model() {
    local name=$1
    local model_name
    for model_name in "${model_names[@]}"; do
        if [ "$model_name" = "$name" ]; then
            return 0
        fi
    done
    return 1
}

model_config() {
    local name=$1
    model_backend=vllm-mlx
    model_vllm_mlx_args=()
    model_swiftlm_args=()
    case "$name" in
        agent)
            model_id="mlx-community/Qwen3.6-35B-A3B-4bit"
            model_port="5413"
            model_vllm_mlx_args=(--max-kv-size 65536 --cache-memory-mb 2048 --max-num-seqs 1 --default-chat-template-kwargs '{"enable_thinking":false}' --enable-auto-tool-choice --tool-call-parser qwen --reasoning-parser qwen3)
            model_swiftlm_args=(--ctx-size 65536 --parallel 1 --turbo-kv)
            ;;
        assistant)
            model_id="mlx-community/gemma-4-26B-A4B-it-qat-4bit"
            model_port="5413"
            model_vllm_mlx_args=(--mllm --max-kv-size 32768 --cache-memory-mb 2048 --max-num-seqs 1 --default-chat-template-kwargs '{"enable_thinking":false}' --enable-auto-tool-choice --tool-call-parser gemma4 --reasoning-parser gemma4)
            model_swiftlm_args=(--vision --ctx-size 32768 --parallel 1)
            ;;
        quality)
            model_id="mlx-community/Qwen3.8-27B-4bit"
            model_port="5413"
            model_vllm_mlx_args=(--mllm --max-kv-size 32768 --cache-memory-mb 2048 --max-num-seqs 1 --default-chat-template-kwargs '{"enable_thinking":false}' --enable-auto-tool-choice --tool-call-parser qwen --reasoning-parser qwen3)
            model_swiftlm_args=(--vision --ctx-size 32768 --parallel 1)
            ;;
        *)
            die "Unknown model profile: $name"
            ;;
    esac
}

selected_backend_for_current_model() {
    local backend=${backend_override:-$model_backend}
    case "$backend" in
        vllm-mlx | swiftlm)
            printf "%s\n" "$backend"
            ;;
        *)
            die "Unsupported backend: %s" "$backend"
            ;;
    esac
}

backend_bin_for_current_model() {
    local backend
    backend=$(selected_backend_for_current_model)

    case "$backend" in
        vllm-mlx)
            printf "%s\n" "vllm-mlx"
            ;;
        swiftlm)
            printf "%s\n" "SwiftLM"
            ;;
    esac
}

build_backend_command() {
    local backend
    local backend_bin
    backend=$(selected_backend_for_current_model)
    backend_bin=$(backend_bin_for_current_model)

    case "$backend" in
        vllm-mlx)
            cmd=("$backend_bin" serve "$model_id" --served-model-name "$model_id" --host 127.0.0.1 --port "$model_port")
            cmd+=("${model_vllm_mlx_args[@]}")
            ;;
        swiftlm)
            cmd=("$backend_bin" --model "$model_id" --port "$model_port")
            cmd+=("${model_swiftlm_args[@]}")
            ;;
    esac
}

pid_file_for() {
    local name=$1
    printf "%s/%s.pid\n" "$state_dir" "$name"
}

log_file_for() {
    local name=$1
    printf "%s/%s.log\n" "$state_dir" "$name"
}

state_file_for() {
    local name=$1
    local key=$2
    printf "%s/%s.%s\n" "$state_dir" "$name" "$key"
}

read_state_for() {
    local name=$1
    local key=$2
    local path
    path=$(state_file_for "$name" "$key")
    if [ -f "$path" ]; then
        sed -n '1p' "$path"
    else
        return 1
    fi
}

write_state_value() {
    local name=$1
    local key=$2
    local value=$3
    local path
    path=$(state_file_for "$name" "$key")
    if [ "$dry_run" -eq 0 ]; then
        printf "%s\n" "$value" >"$path"
    else
        msg "+ printf '%s\n' '%s' > %s" "$value" "$value" "$path"
    fi
}

read_pid_for() {
    local name=$1
    read_state_for "$name" pid
}

process_start_for() {
    local pid=$1
    ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^ *//;s/ *$//'
}

write_state_for() {
    local name=$1
    local pid=$2
    local start_identity=$3
    shift 3

    write_state_value "$name" pid "$pid"
    write_state_value "$name" start "$start_identity"
    write_state_value "$name" backend "$(selected_backend_for_current_model)"
    write_state_value "$name" port "$model_port"
    write_state_value "$name" model "$model_id"
    write_state_value "$name" cmd "$*"
}

clear_state_for() {
    local name=$1
    run rm -f \
        "$(state_file_for "$name" pid)" \
        "$(state_file_for "$name" start)" \
        "$(state_file_for "$name" backend)" \
        "$(state_file_for "$name" port)" \
        "$(state_file_for "$name" model)" \
        "$(state_file_for "$name" cmd)"
}

pid_is_alive() {
    local pid=${1:-}
    [ -n "$pid" ] || return 1
    lsof -p "$pid" >/dev/null 2>&1
}

listener_pid_for() {
    local name=$1
    model_config "$name"
    lsof -nP -iTCP:"$model_port" -sTCP:LISTEN -t 2>/dev/null | head -n 1
}

sync_pid_file_from_listener() {
    local name=$1
    local pid
    pid=$(read_pid_for "$name" 2>/dev/null || true)
    if [ -n "$pid" ] && ! owned_pid_for "$name" >/dev/null 2>&1; then
        msg_verbose "Removing stale state for %s" "$name"
        clear_state_for "$name"
    fi
}

owned_pid_for() {
    local name=$1
    local pid
    local stored_start
    local current_start

    pid=$(read_state_for "$name" pid 2>/dev/null || true)
    [ -n "$pid" ] || return 1
    pid_is_alive "$pid" || return 1

    stored_start=$(read_state_for "$name" start 2>/dev/null || true)
    [ -n "$stored_start" ] || return 1

    current_start=$(process_start_for "$pid")
    [ -n "$current_start" ] || return 1
    [ "$stored_start" = "$current_start" ] || return 1

    printf "%s\n" "$pid"
}

managed_profile_for_pid() {
    local pid=$1
    local name
    local owned_pid

    for name in "${model_names[@]}"; do
        owned_pid=$(owned_pid_for "$name" 2>/dev/null || true)
        if [ -n "$owned_pid" ] && [ "$owned_pid" = "$pid" ]; then
            printf "%s\n" "$name"
            return 0
        fi
    done
    return 1
}

is_running_model() {
    local name=$1
    local pid
    local listener_pid

    sync_pid_file_from_listener "$name"
    pid=$(owned_pid_for "$name" 2>/dev/null || true)
    listener_pid=$(listener_pid_for "$name" 2>/dev/null || true)

    [ -n "$pid" ] && [ -n "$listener_pid" ] && [ "$pid" = "$listener_pid" ]
}

cleanup_stale_pid_for() {
    local name=$1
    sync_pid_file_from_listener "$name"
}

status_model() {
    local name=$1
    local pid
    local listener_pid
    local listener_owner

    model_config "$name"
    cleanup_stale_pid_for "$name"

    pid=$(owned_pid_for "$name" 2>/dev/null || true)
    listener_pid=$(listener_pid_for "$name" 2>/dev/null || true)

    if [ -n "$listener_pid" ] && { [ -z "$pid" ] || [ "$listener_pid" != "$pid" ]; }; then
        listener_owner=$(managed_profile_for_pid "$listener_pid" 2>/dev/null || true)
        if [ -n "$listener_owner" ]; then
            printf "%s stopped port=%s model=%s\n" "$name" "$model_port" "$model_id"
        else
            printf "%s blocked pid=%s port=%s model=%s\n" "$name" "$listener_pid" "$model_port" "$model_id"
        fi
        return 1
    fi

    if [ -n "$pid" ] && [ -n "$listener_pid" ] && curl -fsS --max-time 1 "http://127.0.0.1:${model_port}/v1/models" >/dev/null 2>&1; then
        printf "%s running pid=%s port=%s model=%s\n" "$name" "$pid" "$model_port" "$model_id"
        return 0
    fi

    if [ -n "$pid" ]; then
        printf "%s initializing pid=%s port=%s model=%s\n" "$name" "$pid" "$model_port" "$model_id"
        return 1
    fi

    printf "%s stopped port=%s model=%s\n" "$name" "$model_port" "$model_id"
    return 1
}

start_model() {
    local name=$1
    model_config "$name"
    ensure_state_dir
    cleanup_stale_pid_for "$name"

    local owned_pid
    local listener_pid
    local listener_owner

    owned_pid=$(owned_pid_for "$name" 2>/dev/null || true)
    listener_pid=$(listener_pid_for "$name" 2>/dev/null || true)

    if [ -n "$listener_pid" ] && { [ -z "$owned_pid" ] || [ "$listener_pid" != "$owned_pid" ]; }; then
        listener_owner=$(managed_profile_for_pid "$listener_pid" 2>/dev/null || true)
        if [ -n "$listener_owner" ]; then
            die "%s is running; use switch %s to change physical models" "$listener_owner" "$name"
        fi
        die "%s port %s is already used by unowned pid %s" "$name" "$model_port" "$listener_pid"
    fi

    if [ -n "$owned_pid" ]; then
        if [ -n "$listener_pid" ] && [ "$listener_pid" = "$owned_pid" ]; then
            msg_yellow "%s already running (pid: %s)" "$name" "$owned_pid"
        else
            msg_yellow "%s already initializing (pid: %s)" "$name" "$owned_pid"
        fi
        return 0
    fi

    build_backend_command
    command -v "${cmd[0]}" >/dev/null 2>&1 || die "%s binary not found: %s" "$(selected_backend_for_current_model)" "${cmd[0]}"

    local log_file
    log_file=$(log_file_for "$name")
    run touch "$log_file"
    if [ "$dry_run" -eq 0 ]; then
        printf "\n[%s] Starting profile=%s backend=%s model=%s port=%s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$name" "$(selected_backend_for_current_model)" "$model_id" "$model_port" >>"$log_file"
    fi

    if [ "$verbosity" -gt 0 ]; then
        msg "Starting profile=%s model=%s port=%s" "$name" "$model_id" "$model_port"
    fi
    if [ "$verbosity" -gt 0 ] || [ "$dry_run" -eq 1 ]; then
        msg "+ %s" "$(print_shell_command "${cmd[@]}")"
    fi
    if [ "$dry_run" -eq 1 ]; then
        return 0
    fi

    nohup "${cmd[@]}" >>"$log_file" 2>&1 &
    local pid=$!
    local start_identity
    start_identity=$(process_start_for "$pid" 2>/dev/null || true)
    if [ -z "$start_identity" ]; then
        clear_state_for "$name"
        die "%s failed to start; check logs: %s" "$name" "$log_file"
    fi

    write_state_for "$name" "$pid" "$start_identity" "${cmd[@]}"

    sleep 1
    if ! kill -0 "$pid" 2>/dev/null; then
        clear_state_for "$name"
        die "%s failed to start; check logs: %s" "$name" "$log_file"
    fi

    # Catch short-lived startup failures (e.g. download/DNS errors) before reporting success.
    for _ in $(seq 1 5); do
        sleep 1
        if ! kill -0 "$pid" 2>/dev/null; then
            clear_state_for "$name"
            die "%s failed during startup; check logs: %s" "$name" "$log_file"
        fi
    done

    if curl -fsS --max-time 2 "http://127.0.0.1:${model_port}/v1/models" >/dev/null 2>&1; then
        msg_green "%s ready (pid: %s, port: %s)" "$name" "$pid" "$model_port"
    else
        msg_yellow "%s started but still initializing (pid: %s, port: %s)" "$name" "$pid" "$model_port"
    fi
}

stop_model() {
    local name=$1
    model_config "$name"
    cleanup_stale_pid_for "$name"

    local pid
    local listener_pid
    local listener_owner
    pid=$(owned_pid_for "$name" 2>/dev/null || true)
    listener_pid=$(listener_pid_for "$name" 2>/dev/null || true)

    if [ -z "$pid" ]; then
        if [ -n "$listener_pid" ]; then
            listener_owner=$(managed_profile_for_pid "$listener_pid" 2>/dev/null || true)
            if [ -z "$listener_owner" ]; then
                die "%s port %s is used by unowned pid %s; refusing to stop it" "$name" "$model_port" "$listener_pid"
            fi
        fi
        msg_yellow "%s is not running" "$name"
        clear_state_for "$name"
        return 0
    fi

    msg_verbose "Stopping %s pid %s" "$name" "$pid"

    if [ "$dry_run" -eq 1 ]; then
        msg "+ kill %s" "$pid"
        return 0
    fi

    kill "$pid" 2>/dev/null || true

    for _ in $(seq 1 40); do
        if ! pid_is_alive "$pid"; then
            break
        fi
        sleep 0.25
    done

    if pid_is_alive "$pid"; then
        msg_yellow "%s still running; sending SIGKILL to %s" "$name" "$pid"
        kill -KILL "$pid" 2>/dev/null || true
        sleep 0.5
    fi

    if pid_is_alive "$pid"; then
        die "Failed to stop %s; pid still alive: %s" "$name" "$pid"
    fi

    clear_state_for "$name"
    msg_green "%s stopped" "$name"
}

for_each_target() {
    local target=$1
    local fn=$2

    if [ "$target" = "all" ]; then
        local model_name
        for model_name in "${model_names[@]}"; do
            "$fn" "$model_name"
        done
        return 0
    fi

    is_known_model "$target" || die "Unknown model profile: $target"
    "$fn" "$target"
}

cmd_list() {
    local model_name
    for model_name in "${model_names[@]}"; do
        model_config "$model_name"
        printf "%s backend=%s port=%s model=%s\n" "$model_name" "$(selected_backend_for_current_model)" "$model_port" "$model_id"
    done
}

cmd_start() {
    [ "$command_model" != "all" ] || die "start requires one physical model; use switch to change models"
    for_each_target "$command_model" start_model
}

cmd_switch() {
    local target=$command_model
    local name
    local pid

    [ "$target" != "all" ] || die "switch requires one physical model"
    is_known_model "$target" || die "Unknown model profile: $target"

    for name in "${model_names[@]}"; do
        pid=$(owned_pid_for "$name" 2>/dev/null || true)
        if [ -n "$pid" ]; then
            if [ "$name" = "$target" ]; then
                if is_running_model "$name"; then
                    msg_yellow "%s already running (pid: %s)" "$name" "$pid"
                else
                    msg_yellow "%s already initializing (pid: %s)" "$name" "$pid"
                fi
                return 0
            fi
            stop_model "$name"
        fi
    done
    start_model "$target"
}

cmd_stop() {
    for_each_target "$command_model" stop_model
}

cmd_restart() {
    [ "$command_model" != "all" ] || die "restart requires one physical model"
    for_each_target "$command_model" stop_model
    for_each_target "$command_model" start_model
}

cmd_status() {
    local target=${command_model:-all}
    local any_failed=0

    if [ "$target" = "all" ]; then
        local model_name
        for model_name in "${model_names[@]}"; do
            if ! status_model "$model_name"; then
                any_failed=1
            fi
        done
        return "$any_failed"
    fi

    is_known_model "$target" || die "Unknown model profile: $target"
    status_model "$target"
}

cmd_is_running() {
    local target=${command_model:-}
    [ -n "$target" ] || die "is-running requires a model profile"
    is_known_model "$target" || die "Unknown model profile: $target"
    cleanup_stale_pid_for "$target"
    is_running_model "$target"
}

cmd_logs() {
    local target=${command_model:-}
    local lines=${command_arg:-40}
    [ -n "$target" ] || die "logs requires a model profile"
    is_known_model "$target" || die "Unknown model profile: $target"

    ensure_state_dir
    local log_file
    log_file=$(log_file_for "$target")
    if [ ! -f "$log_file" ]; then
        msg_yellow "No log file yet: $log_file"
        return 0
    fi
    run tail -n "$lines" "$log_file"
}

cmd_follow_logs() {
    local target=${command_model:-}
    [ -n "$target" ] || die "follow-logs requires a model profile"
    is_known_model "$target" || die "Unknown model profile: $target"

    ensure_state_dir
    local log_file
    log_file=$(log_file_for "$target")
    run touch "$log_file"
    run tail -f "$log_file"
}

chat_health_body() {
    local with_tools=$1

    if [ "$with_tools" -eq 1 ]; then
        printf '{"model":"%s","messages":[{"role":"user","content":"Do not think. Reply with exactly: ok"}],"max_tokens":16,"temperature":0,"stream":false,"chat_template_kwargs":{"enable_thinking":false},"tools":[{"type":"function","function":{"name":"noop","description":"No-op health-check tool.","parameters":{"type":"object","properties":{},"additionalProperties":false}}}],"tool_choice":"none"}\n' "$model_id"
    else
        printf '{"model":"%s","messages":[{"role":"user","content":"Do not think. Reply with exactly: ok"}],"max_tokens":16,"temperature":0,"stream":false,"chat_template_kwargs":{"enable_thinking":false}}\n' "$model_id"
    fi
}

chat_health_for() {
    local name=$1
    local with_tools=$2
    local response

    model_config "$name"
    response=$(chat_health_body "$with_tools" | curl -fsS --max-time 15 \
        -H 'Content-Type: application/json' \
        -d @- \
        "http://127.0.0.1:${model_port}/v1/chat/completions" 2>/dev/null || true)

    if printf '%s\n' "$response" | jq -e '.choices[0].message.content | strings | length > 0' >/dev/null 2>&1; then
        return 0
    fi

    response=$(printf '{"model":"%s","messages":[{"role":"user","content":"Reply with exactly: ok"}],"max_tokens":16,"temperature":0,"stream":false}\n' "$model_id" | curl -fsS --max-time 15 \
        -H 'Content-Type: application/json' \
        -d @- \
        "http://127.0.0.1:${model_port}/v1/chat/completions" 2>/dev/null || true)

    printf '%s\n' "$response" | jq -e '.choices[0].message.content | strings | length > 0' >/dev/null 2>&1
}

cmd_doctor() {
    local backend
    local backend_bin
    local model_name

    printf 'llm-server doctor\n'
    printf 'state_dir=%s\n' "$state_dir"
    printf 'deep=%s\n' "$doctor_deep"

    for model_name in "${model_names[@]}"; do
        model_config "$model_name"
        backend=$(selected_backend_for_current_model)
        backend_bin=$(backend_bin_for_current_model)
        printf '%s backend=%s binary=%s ' "$model_name" "$backend" "$backend_bin"
        if command -v "$backend_bin" >/dev/null 2>&1; then
            printf 'resolved=%s\n' "$(command -v "$backend_bin")"
        else
            printf 'resolved=missing\n'
        fi
    done

    if [ "${backend_override:-}" != "swiftlm" ] && ! command -v SwiftLM >/dev/null 2>&1; then
        printf 'warning=SwiftLM fallback missing: SwiftLM\n'
    fi

    cmd_status || true

    if [ "$doctor_deep" -eq 1 ]; then
        for model_name in "${model_names[@]}"; do
            if status_model "$model_name" >/dev/null 2>&1; then
                if chat_health_for "$model_name" 0; then
                    printf '%s chat_health=ok\n' "$model_name"
                else
                    printf '%s chat_health=failed\n' "$model_name"
                fi
                if chat_health_for "$model_name" 1; then
                    printf '%s tool_request_health=ok\n' "$model_name"
                else
                    printf '%s tool_request_health=failed\n' "$model_name"
                fi
            fi
        done
    fi
}

main() {
    process_arguments "$@"

    case "$command_name" in
        list)
            cmd_list
            ;;
        start)
            cmd_start
            ;;
        switch)
            cmd_switch
            ;;
        stop)
            cmd_stop
            ;;
        restart)
            cmd_restart
            ;;
        status)
            cmd_status
            ;;
        is-running)
            cmd_is_running
            ;;
        logs)
            cmd_logs
            ;;
        follow-logs)
            cmd_follow_logs
            ;;
        doctor)
            cmd_doctor
            ;;
        *)
            msg_red "Unknown command: $command_name"
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"
