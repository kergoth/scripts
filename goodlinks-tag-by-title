#!/usr/bin/env bash

set -euo pipefail

PATH="${GOODLINKS_CLI_DIR:-/Applications/GoodLinks.app/Contents/MacOS/CLI}${PATH:+:$PATH}"

dry_run=
case "${1:-}" in
    -n|--dry-run)
        dry_run=1
        shift
        ;;
    -h|--help)
        echo >&2 "${0##*/} [-n] [--dry-run] [-h] [--help] TITLE_REGEX TAG"
        exit 2
        ;;
esac

title_pattern="$1"
tag="$2"

goodlinks-links-json \
  | jq -r --arg pattern "$title_pattern" --arg tag "$tag" '
      .data[]
      | select((.title // "") | test($pattern; "i"))
      | select(((.tags // []) | index($tag)) == null)
      | .id
    ' \
  | xargs -n 1 -t ${dry_run:+echo }goodlinks link edit --add-tag "$tag"
