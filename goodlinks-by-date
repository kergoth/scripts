#!/usr/bin/env bash
# Usage: goodlinks-by-date [options]
#
# Filter goodlinksctl JSON by date window. Reads JSON from stdin (either
# the goodlinksctl {data: [...]} envelope or a bare array) and writes a
# filtered JSON array to stdout.
#
# Options:
#     -d DAYS     Window size in days (default: 7)
#     -r          Oldest-first mode: window starts from the oldest article
#                 instead of the most recent N days
#     -n          Dry run, pass input through unmodified
#     -v          Increase verbosity, can be specified multiple times
#     -q          Decrease verbosity, can be specified multiple times
#     -h          Show this help message
set -euo pipefail

show_help() {
    sed -n '/^# Usage:/,/^# *-h /p' "${BASH_SOURCE[0]}" | sed 's/^# *//'
}

process_arguments() {
    days=7
    oldest=0
    dry_run=0
    verbosity=0

    while getopts 'd:rnvqh' opt; do
        case "$opt" in
            d) days=$OPTARG ;;
            r) oldest=1 ;;
            n) dry_run=1 ;;
            v) verbosity=$((verbosity + 1)) ;;
            q) verbosity=$((verbosity - 1)) ;;
            h) show_help; exit 0 ;;
            \?)
                echo "Unknown option: -$OPTARG" >&2
                show_help >&2
                exit 1
                ;;
        esac
    done
    shift $((OPTIND - 1))
}

msg() {
    fmt="$1"
    if [ $# -gt 1 ]; then
        shift
    fi
    # shellcheck disable=SC2059
    printf -- "$fmt\n" "$@" >&2
}

msg_verbose() {
    if [ "${verbosity:-0}" -gt 0 ]; then
        msg "$@"
    fi
}

die() {
    msg "error: %s" "$*"
    exit 1
}

main() {
    process_arguments "$@"

    command -v jq >/dev/null 2>&1 || die "jq not found in PATH"

    if [ -t 0 ]; then
        die "no input: pipe goodlinksctl JSON to stdin"
    fi

    input_json=$(cat)

    if [ "${dry_run:-0}" = "1" ]; then
        printf '%s\n' "$input_json"
        return
    fi

    if [ "$oldest" = "1" ]; then
        msg_verbose "Oldest-first: %d-day window from oldest article" "$days"
        printf '%s' "$input_json" | jq \
            --argjson days "$days" \
            '(if type == "array" then . else .data end)
            | sort_by(.addedAt)
            | if length == 0 then []
              else
                (.[0].addedAt | fromdate) as $oldest_epoch |
                (($oldest_epoch + ($days * 86400)) | todate) as $window_end |
                map(select(.addedAt <= $window_end))
              end'
    else
        cutoff=$(date -v-"${days}"d -u +"%Y-%m-%dT%H:%M:%SZ")
        msg_verbose "Filtering to articles added since %s" "$cutoff"
        printf '%s' "$input_json" | jq \
            --arg cutoff "$cutoff" \
            '[(if type == "array" then . else .data end)[] | select(.addedAt >= $cutoff)]'
    fi
}

main "$@"
