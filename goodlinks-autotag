#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["platformdirs"]
# ///
"""Auto-tag GoodLinks links by URL host, author, or title, driven by a rule table.

Rules load from a TOML config file (see --config for the default path;
run with no config present to print the expected format). Dry-run by
default; pass --apply to actually write tags via goodlinksctl.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tomllib
from collections.abc import Iterable
from dataclasses import dataclass
from typing import Any
from urllib.parse import urlparse

from platformdirs import user_config_path

CONFIG_PATH = user_config_path("goodlinks") / "autotag.toml"

SAMPLE_CONFIG = """\
# tags in this list are mutually exclusive per link: a rule won't add
# one if the link already has a different tag from this set
exclusive_tags = ["reference", "to-watch", "to-do", "to-be-read"]

[[rule]]
hosts = ["github.com"]
tags = ["to-do"]

[[rule]]
hosts = ["youtube.com", "youtu.be"]
tags = ["to-watch"]
exclude_path = "/(channel|c|user)/|/@"

[[rule]]
hosts = ["youtube.com", "youtu.be"]
tags = ["to-subscribe"]
include_path = "/(channel|c|user)/|/@"

[[rule]]
authors = ["Some Channel Name"]
tags = ["some-topic"]

[[rule]]
title = '\\b(some|title|words)\\b'
tags = ["some-topic"]
"""


@dataclass(frozen=True)
class Rule:
    """Add tags to links matching hosts, authors, and/or title.

    Every matcher present on a rule must match (AND); a rule with more
    than one matcher type narrows rather than broadens. hosts and
    authors are sets of literal values, matched exactly (case-
    insensitive for authors) rather than as substrings or regexes:
    author names on GoodLinks aren't a controlled vocabulary, and two
    unrelated channels can share a substring (e.g. "Retro Handhelds"
    vs. "Joey's Retro Handhelds"), so exact match avoids false
    positives that regex/substring matching would introduce. hosts is
    matched against the URL hostname (minus leading "www."), never
    against the path or query string, so a host name appearing
    incidentally elsewhere in a URL can't trigger a rule.
    include_path/exclude_path are only consulted once hosts has
    already matched; exclude_path wins if both match. title is a
    single regex matched case-insensitively, since titles are free
    text where substring/word-boundary matching is the point. A rule
    must specify at least one matcher, or it would match every link.
    """

    hosts: Iterable[str] = ()
    tags: Iterable[str] = ()
    include_path: re.Pattern[str] | None = None
    exclude_path: re.Pattern[str] | None = None
    authors: Iterable[str] = ()
    title: re.Pattern[str] | None = None

    def __post_init__(self) -> None:
        object.__setattr__(self, "hosts", frozenset(self.hosts))
        object.__setattr__(self, "tags", frozenset(self.tags))
        object.__setattr__(self, "authors", frozenset(a.lower() for a in self.authors))
        if not (self.hosts or self.authors or self.title):
            raise ValueError(
                f"rule with tags {sorted(self.tags)} has no matcher "
                "(hosts/authors/title)"
            )

    def matches(self, host: str, url: str, title: str, author: str) -> bool:
        if self.hosts and host not in self.hosts:
            return False
        if self.exclude_path and self.exclude_path.search(url):
            return False
        if self.include_path and not self.include_path.search(url):
            return False
        if self.authors and author.lower() not in self.authors:
            return False
        if self.title and not self.title.search(title):
            return False
        return True


def load_config(path: Any) -> tuple[list[Rule], set[str]]:
    if not path.exists():
        sys.stderr.write(
            f"warning: no config file at {path}; nothing to do.\n"
            "sample config:\n\n" + SAMPLE_CONFIG
        )
        return [], set()

    with path.open("rb") as f:
        data = tomllib.load(f)

    rules = [
        Rule(
            hosts=r.get("hosts", ()),
            tags=r["tags"],
            include_path=re.compile(r["include_path"]) if "include_path" in r else None,
            exclude_path=re.compile(r["exclude_path"]) if "exclude_path" in r else None,
            authors=r.get("authors", ()),
            title=re.compile(r["title"], re.IGNORECASE) if "title" in r else None,
        )
        for r in data.get("rule", [])
    ]
    exclusive_tags = set(data.get("exclusive_tags", []))
    return rules, exclusive_tags


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True, check=False)


def fetch_links() -> list[dict[str, Any]]:
    cmd = ["goodlinksctl", "--json", "links", "list", "--all-pages", "--limit", "250"]
    proc = run(cmd)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout)
        raise SystemExit(proc.returncode)
    payload = json.loads(proc.stdout)
    return payload.get("data", [])


def host_of(url: str) -> str:
    host = (urlparse(url).hostname or "").lower()
    return host.removeprefix("www.")


def tags_to_add(link: dict[str, Any], rules: list[Rule], exclusive_tags: set[str]) -> list[str]:
    url = str(link.get("url", ""))
    host = host_of(url)
    title = str(link.get("title", ""))
    author = str(link.get("author", ""))
    existing = {str(t) for t in link.get("tags") or []}
    has_exclusive_tag = bool(existing & exclusive_tags)

    tags: list[str] = []
    for rule in rules:
        if not rule.matches(host, url, title, author):
            continue
        for tag in rule.tags:
            if tag in existing or tag in tags:
                continue
            if has_exclusive_tag and tag in exclusive_tags:
                continue
            tags.append(tag)

    return tags


def apply_updates(updates: list[dict[str, Any]]) -> int:
    payload = "\n".join(json.dumps(u) for u in updates)
    proc = subprocess.run(
        ["goodlinksctl", "--json", "links", "update", "--stdin-jsonl"],
        input=payload,
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode not in (0, 7):
        sys.stderr.write(proc.stderr or proc.stdout)
        return proc.returncode
    print(proc.stdout)
    return 0 if proc.returncode == 0 else 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--apply", action="store_true", help="Write tags instead of dry-run"
    )
    parser.add_argument(
        "--config",
        default=CONFIG_PATH,
        type=type(CONFIG_PATH),
        help=f"Path to rules config (default: {CONFIG_PATH})",
    )
    args = parser.parse_args()

    rules, exclusive_tags = load_config(args.config)
    if not rules:
        return 0

    links = fetch_links()
    pending = []
    for link in links:
        add = tags_to_add(link, rules, exclusive_tags)
        if not add:
            continue
        pending.append({"id": link["id"], "addedTags": add})
        print(f"{link['id']}\t+{','.join(add)}\t{link.get('title', '')}")

    mode = "apply" if args.apply else "dry-run"
    print(f"summary\tmode={mode}\tmatched={len(pending)}")

    if not pending:
        return 0
    if not args.apply:
        return 0
    return apply_updates(pending)


if __name__ == "__main__":
    raise SystemExit(main())
