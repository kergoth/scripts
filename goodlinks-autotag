#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["platformdirs"]
# ///
"""Auto-tag GoodLinks links by URL host, driven by a rule table.

Rules load from a TOML config file (see --config for the default path;
run with no config present to print the expected format). Dry-run by
default; pass --apply to actually write tags via goodlinksctl.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tomllib
from collections.abc import Iterable
from dataclasses import dataclass
from typing import Any
from urllib.parse import urlparse

from platformdirs import user_config_path

CONFIG_PATH = user_config_path("goodlinks") / "autotag.toml"

SAMPLE_CONFIG = """\
# tags in this list are mutually exclusive per link: a rule won't add
# one if the link already has a different tag from this set
exclusive_tags = ["reference", "to-watch", "to-do", "to-be-read"]

[[rule]]
hosts = ["github.com"]
tags = ["to-do"]

[[rule]]
hosts = ["youtube.com", "youtu.be"]
tags = ["to-watch"]
exclude_path = "/(channel|c|user)/|/@"

[[rule]]
hosts = ["youtube.com", "youtu.be"]
tags = ["to-subscribe"]
include_path = "/(channel|c|user)/|/@"
"""


@dataclass(frozen=True)
class Rule:
    """Add tags to links whose host matches, optionally gated by URL path.

    hosts is matched exactly against the URL hostname (minus leading
    "www."), never against the path or query string, so a host name
    appearing incidentally elsewhere in a URL can't trigger a rule.
    include_path/exclude_path are only consulted once hosts has already
    matched; exclude_path wins if both match.
    """

    hosts: Iterable[str]
    tags: Iterable[str]
    include_path: re.Pattern[str] | None = None
    exclude_path: re.Pattern[str] | None = None

    def __post_init__(self) -> None:
        object.__setattr__(self, "hosts", frozenset(self.hosts))
        object.__setattr__(self, "tags", frozenset(self.tags))

    def matches(self, host: str, url: str) -> bool:
        if host not in self.hosts:
            return False
        if self.exclude_path and self.exclude_path.search(url):
            return False
        if self.include_path and not self.include_path.search(url):
            return False
        return True


def load_config(path: Any) -> tuple[list[Rule], set[str]]:
    if not path.exists():
        sys.stderr.write(
            f"warning: no config file at {path}; nothing to do.\n"
            "sample config:\n\n" + SAMPLE_CONFIG
        )
        return [], set()

    with path.open("rb") as f:
        data = tomllib.load(f)

    rules = [
        Rule(
            hosts=r["hosts"],
            tags=r["tags"],
            include_path=re.compile(r["include_path"]) if "include_path" in r else None,
            exclude_path=re.compile(r["exclude_path"]) if "exclude_path" in r else None,
        )
        for r in data.get("rule", [])
    ]
    exclusive_tags = set(data.get("exclusive_tags", []))
    return rules, exclusive_tags


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True, check=False)


def fetch_links() -> list[dict[str, Any]]:
    cmd = ["goodlinksctl", "--json", "links", "list", "--all-pages", "--limit", "250"]
    proc = run(cmd)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout)
        raise SystemExit(proc.returncode)
    payload = json.loads(proc.stdout)
    return payload.get("data", [])


def host_of(url: str) -> str:
    host = (urlparse(url).hostname or "").lower()
    return host.removeprefix("www.")


def tags_to_add(link: dict[str, Any], rules: list[Rule], exclusive_tags: set[str]) -> list[str]:
    url = str(link.get("url", ""))
    host = host_of(url)
    existing = {str(t) for t in link.get("tags") or []}
    has_exclusive_tag = bool(existing & exclusive_tags)

    tags: list[str] = []
    for rule in rules:
        if not rule.matches(host, url):
            continue
        for tag in rule.tags:
            if tag in existing or tag in tags:
                continue
            if has_exclusive_tag and tag in exclusive_tags:
                continue
            tags.append(tag)

    return tags


def apply_updates(updates: list[dict[str, Any]]) -> int:
    payload = "\n".join(json.dumps(u) for u in updates)
    proc = subprocess.run(
        ["goodlinksctl", "--json", "links", "update", "--stdin-jsonl"],
        input=payload,
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode not in (0, 7):
        sys.stderr.write(proc.stderr or proc.stdout)
        return proc.returncode
    print(proc.stdout)
    return 0 if proc.returncode == 0 else 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--apply", action="store_true", help="Write tags instead of dry-run"
    )
    parser.add_argument(
        "--config",
        default=CONFIG_PATH,
        type=type(CONFIG_PATH),
        help=f"Path to rules config (default: {CONFIG_PATH})",
    )
    args = parser.parse_args()

    rules, exclusive_tags = load_config(args.config)
    if not rules:
        return 0

    links = fetch_links()
    pending = []
    for link in links:
        add = tags_to_add(link, rules, exclusive_tags)
        if not add:
            continue
        pending.append({"id": link["id"], "addedTags": add})
        print(f"{link['id']}\t+{','.join(add)}\t{link.get('title', '')}")

    mode = "apply" if args.apply else "dry-run"
    print(f"summary\tmode={mode}\tmatched={len(pending)}")

    if not pending:
        return 0
    if not args.apply:
        return 0
    return apply_updates(pending)


if __name__ == "__main__":
    raise SystemExit(main())
