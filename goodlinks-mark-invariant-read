#!/usr/bin/env python3
"""Mark GoodLinks links read when tagged with a read-invariant tag.

Some tags (e.g. reference) mark permanent lookups rather than something
to act on later, so unread/read status carries no meaning for them.

Dry-run by default; pass --apply to actually write read status via the
GoodLinks CLI.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from typing import Any

GOODLINKS_CLI_DIR = os.environ.get(
    "GOODLINKS_CLI_DIR", "/Applications/GoodLinks.app/Contents/MacOS/CLI"
)
INVARIANT_READ_TAGS = {"reference"}

# The GoodLinks app ships its CLI inside the app bundle, off PATH; set
# GOODLINKS_CLI_DIR to point at a stub or a relocated copy.
os.environ["PATH"] = f"{GOODLINKS_CLI_DIR}:{os.environ.get('PATH', '')}"


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True)


def fetch_links() -> list[dict[str, Any]]:
    cmd = ["goodlinks-links-json"]
    proc = run(cmd)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout)
        raise SystemExit(proc.returncode)
    payload = json.loads(proc.stdout)
    return payload.get("data", [])


def needs_read(link: dict[str, Any]) -> bool:
    tags = {str(t) for t in link.get("tags") or []}
    return bool(tags & INVARIANT_READ_TAGS) and not link.get("readAt")


def apply_updates(ids: list[str]) -> int:
    failures = 0
    for link_id in ids:
        proc = subprocess.run(
            ["goodlinks", "link", "edit", link_id, "--read"],
            text=True,
            capture_output=True,
        )
        if proc.returncode != 0:
            failures += 1
            sys.stderr.write(f"{link_id}: {proc.stderr or proc.stdout}")
    if failures:
        sys.stderr.write(f"{failures} of {len(ids)} links could not be marked read\n")
        return 1
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="Write read status instead of dry-run")
    args = parser.parse_args()

    links = fetch_links()
    pending = [link for link in links if needs_read(link)]
    for link in pending:
        print(f"{link['id']}\t{link.get('title', '')}")

    mode = "apply" if args.apply else "dry-run"
    print(f"summary\tmode={mode}\tmatched={len(pending)}")

    if not pending:
        return 0
    if not args.apply:
        return 0
    return apply_updates([link["id"] for link in pending])


if __name__ == "__main__":
    raise SystemExit(main())
